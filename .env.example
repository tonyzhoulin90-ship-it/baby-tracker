# 宝宝成长记录应用 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== 基本配置 ====================
# 宝宝出生日期 (格式: YYYY-MM-DD)
BIRTH_DATE=2024-01-15

# 访问密码 (家人访问时使用)
APP_PASSWORD=your_secret_password

# ==================== Google Sheets 配置 ====================
# Google Sheets ID (从表格 URL 中获取)
# 例如: https://docs.google.com/spreadsheets/d/XXXXXXXX/edit
# SHEET_ID = XXXXXXXX
SHEET_ID=your_google_sheet_id_here

# 所有者邮箱 (用于权限控制)
OWNER_EMAIL=your_email@gmail.com

# Service Account JSON (完整 JSON 内容，用于读写 Sheets)
# 从 Google Cloud Console 创建 Service Account 后下载 JSON
# 将整个 JSON 内容压缩为一行填入
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ==================== Google Drive OAuth 配置 ====================
# 用于上传照片到用户个人 Drive
# 需要通过 OAuth2 流程获取 Refresh Token

# 从 Google Cloud Console 获取
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret

# 通过 OAuth Playground 或代码获取的 Refresh Token
GOOGLE_OAUTH_REFRESH_TOKEN=your_refresh_token
